        "Ruff: Lint",
        "Ruff: Format Check",
        "ty: Type Check"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Fix & Format All",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Ruff: Lint & Fix",
        "Ruff: Format"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
